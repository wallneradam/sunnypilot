+package main
+
+import (
+	"encoding/json"
+	"math"
+	"os"
+	"testing"
+
+	"capnproto.org/go/capnp/v3"
+)
+
+type fixtureWay struct {
+	Index  int          `json:"index"`
+	Name   string       `json:"name"`
+	Ref    string       `json:"ref"`
+	Lanes  uint8        `json:"lanes"`
+	OneWay bool         `json:"oneway"`
+	Speed  float64      `json:"speed"`
+	Nodes  [][2]float64 `json:"nodes"`
+}
+
+func fixtureOffline(t *testing.T, fixtures []fixtureWay) (Offline, map[int]Way) {
+	t.Helper()
+	_, segment, err := capnp.NewMessage(capnp.SingleSegment(nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	offline, err := NewRootOffline(segment)
+	if err != nil {
+		t.Fatal(err)
+	}
+	offline.SetMinLat(46.0)
+	offline.SetMaxLat(48.0)
+	offline.SetMinLon(18.0)
+	offline.SetMaxLon(20.0)
+	ways, err := offline.NewWays(int32(len(fixtures)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	byIndex := map[int]Way{}
+	for i, fixture := range fixtures {
+		way := ways.At(i)
+		if err := way.SetName(fixture.Name); err != nil {
+			t.Fatal(err)
+		}
+		if err := way.SetRef(fixture.Ref); err != nil {
+			t.Fatal(err)
+		}
+		way.SetLanes(fixture.Lanes)
+		way.SetOneWay(fixture.OneWay)
+		way.SetMaxSpeed(fixture.Speed / 3.6)
+		nodes, err := way.NewNodes(int32(len(fixture.Nodes)))
+		if err != nil {
+			t.Fatal(err)
+		}
+		minLat, minLon, maxLat, maxLon := 90.0, 180.0, -90.0, -180.0
+		for n, point := range fixture.Nodes {
+			node := nodes.At(n)
+			node.SetLatitude(point[0])
+			node.SetLongitude(point[1])
+			minLat, maxLat = math.Min(minLat, point[0]), math.Max(maxLat, point[0])
+			minLon, maxLon = math.Min(minLon, point[1]), math.Max(maxLon, point[1])
+		}
+		way.SetMinLat(minLat)
+		way.SetMaxLat(maxLat)
+		way.SetMinLon(minLon)
+		way.SetMaxLon(maxLon)
+		byIndex[fixture.Index] = way
+	}
+	return offline, byIndex
+}
+
+func domsodFixture(t *testing.T) (Offline, map[int]Way) {
+	t.Helper()
+	data, err := os.ReadFile("testdata/domsod.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fixtures []fixtureWay
+	if err := json.Unmarshal(data, &fixtures); err != nil {
+		t.Fatal(err)
+	}
+	return fixtureOffline(t, fixtures)
+}
+
+func TestDomsodNumberedRoadContinuesAcrossStreetNameChange(t *testing.T) {
+	offline, ways := domsodFixture(t)
+	for _, reverseOrder := range []bool{false, true} {
+		t.Run(map[bool]string{false: "original order", true: "reversed order"}[reverseOrder], func(t *testing.T) {
+			if reverseOrder {
+				data, err := os.ReadFile("testdata/domsod.json")
+				if err != nil {
+					t.Fatal(err)
+				}
+				var fixtures []fixtureWay
+				if err := json.Unmarshal(data, &fixtures); err != nil {
+					t.Fatal(err)
+				}
+				for i, j := 0, len(fixtures)-1; i < j; i, j = i+1, j-1 {
+					fixtures[i], fixtures[j] = fixtures[j], fixtures[i]
+				}
+				offline, ways = fixtureOffline(t, fixtures)
+			}
+			result, err := NextWay(ways[700], offline, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			name, _ := result.Way.Name()
+			ref, _ := result.Way.Ref()
+			if name != "Kossuth Lajos utca" || ref != "51" || result.IsForward {
+				t.Fatalf("northbound continuation: name=%q ref=%q forward=%v", name, ref, result.IsForward)
+			}
+			back, err := NextWay(ways[769], offline, true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			name, _ = back.Way.Name()
+			ref, _ = back.Way.Ref()
+			if name != "Tassi út" || ref != "51" || !back.IsForward {
+				t.Fatalf("southbound continuation: name=%q ref=%q forward=%v", name, ref, back.IsForward)
+			}
+		})
+	}
+}
+
+func targetsForFixturePath(t *testing.T, ways map[int]Way, indices []int, isForward bool) []Velocity {
+	t.Helper()
+	state := State{CurrentWay: CurrentWay{Way: ways[indices[0]], OnWay: OnWayResult{IsForward: isForward}}}
+	for _, index := range indices[1:] {
+		state.NextWays = append(state.NextWays, NextWayResult{Way: ways[index], IsForward: isForward})
+	}
+	curvatures, err := GetStateCurvatures(&state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return GetTargetVelocities(curvatures)
+}
+
+func hasTarget(targets []Velocity, expectedKph float64) bool {
+	for _, target := range targets {
+		if math.Abs(target.Velocity*3.6-expectedKph) < 0.00001 {
+			return true
+		}
+	}
+	return false
+}
+
+func TestDomsodMainRoadAvoidsSideBranchCurveTargets(t *testing.T) {
+	_, ways := domsodFixture(t)
+	state := State{CurrentWay: CurrentWay{Way: ways[700], OnWay: OnWayResult{IsForward: false}},
+		NextWays: []NextWayResult{{Way: ways[5], IsForward: true}}}
+	curves, err := GetStateCurvatures(&state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	oldTargets := GetTargetVelocities(curves)
+	if !hasTarget(oldTargets, 33.75393791198731) || !hasTarget(oldTargets, 24.094011497497558) {
+		t.Fatal("side branch did not reproduce both recorded false targets")
+	}
+	targets := targetsForFixturePath(t, ways, []int{700, 769, 851, 850, 930}, false)
+	if len(targets) == 0 {
+		t.Fatal("no curve targets on the main-road path")
+	}
+	for _, target := range targets {
+		if target.Velocity*3.6 <= 55 {
+			t.Fatalf("unexpected low target on road 51: %.6f km/h", target.Velocity*3.6)
+		}
+	}
+}
+
+func TestDomsodRealMainRoadBendKeepsItsCurveTarget(t *testing.T) {
+	_, ways := domsodFixture(t)
+	targets := targetsForFixturePath(t, ways, []int{848, 847, 213, 695}, false)
+	if !hasTarget(targets, 30.884868621826172) {
+		t.Fatal("the separate real bend no longer reproduces its recorded target")
+	}
+}
+
+func TestNextWayRefPriorityAndFallbacks(t *testing.T) {
+	junction := [2]float64{47.001, 19.0}
+	for _, tc := range []struct {
+		name, currentRef, otherRef    string
+		reverseOneWay, sharp, wantRef bool
+	}{
+		{name: "exact ref beats street name", currentRef: "51", otherRef: "51", wantRef: true},
+		{name: "shared ref beats street name", currentRef: "51; 52", otherRef: "52", wantRef: true},
+		{name: "missing ref falls back to name"},
+		{name: "unmatched ref falls back to name", currentRef: "51", otherRef: "52"},
+		{name: "reverse oneway is rejected", currentRef: "51", otherRef: "51", reverseOneWay: true},
+		{name: "invalid connection falls back to name", currentRef: "51", otherRef: "51", sharp: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			current := fixtureWay{Index: 0, Name: "Old street", Ref: tc.currentRef, Lanes: 2,
+				Nodes: [][2]float64{{47.0, 19.0}, {47.000995, 19.0}, junction}}
+			sameName := fixtureWay{Index: 1, Name: "Old street", Lanes: 2,
+				Nodes: [][2]float64{junction, {47.0018, 18.9997}}}
+			other := fixtureWay{Index: 2, Name: "New street", Ref: tc.otherRef, Lanes: 2,
+				Nodes: [][2]float64{junction, {47.0018, 19.0002}}}
+			if tc.reverseOneWay {
+				other.OneWay = true
+				other.Nodes[0], other.Nodes[1] = other.Nodes[1], other.Nodes[0]
+			}
+			if tc.sharp {
+				other.Nodes[1] = [2]float64{47.001, 19.000008}
+			}
+			offline, ways := fixtureOffline(t, []fixtureWay{current, sameName, other})
+			result, err := NextWay(ways[0], offline, true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			name, _ := result.Way.Name()
+			want := "Old street"
+			if tc.wantRef {
+				want = "New street"
+			}
+			if name != want {
+				t.Fatalf("next street=%q, want %q", name, want)
+			}
+		})
+	}
+}
+
+func TestDownloadedDomsodMap(t *testing.T) {
+	path := os.Getenv("MAPD_REPLAY_TILE")
+	if path == "" {
+		t.Skip("set MAPD_REPLAY_TILE to the recorded offline map tile")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	message, err := capnp.UnmarshalPacked(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	offline, err := ReadRootOffline(message)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ways, err := offline.Ways()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name                string
+		index               int
+		position            Position
+		firstName, firstRef string
+		wantLowTarget       bool
+	}{
+		{name: "Tassi on road 51", index: 700,
+			position:  Position{Latitude: 47.0842474, Longitude: 19.0049373, Bearing: 348.5088},
+			firstName: "Kossuth Lajos utca", firstRef: "51"},
+		{name: "Dozsa on road 52305", index: 848,
+			position:  Position{Latitude: 47.0900961, Longitude: 19.01545, Bearing: 123.7624},
+			firstName: "Dózsa György út", firstRef: "52305", wantLowTarget: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			current := CurrentWay{Way: ways.At(tc.index), OnWay: OnWayResult{IsForward: false}}
+			next, err := NextWays(tc.position, current, offline, false)
+			if err != nil || len(next) == 0 {
+				t.Fatalf("no next ways: %v", err)
+			}
+			name, _ := next[0].Way.Name()
+			ref, _ := next[0].Way.Ref()
+			if name != tc.firstName || ref != tc.firstRef {
+				t.Fatalf("next way %q ref=%q", name, ref)
+			}
+			state := State{CurrentWay: current, NextWays: next, Position: tc.position}
+			curves, err := GetStateCurvatures(&state)
+			if err != nil {
+				t.Fatal(err)
+			}
+			targets := GetTargetVelocities(curves)
+			minKph := math.Inf(1)
+			for _, target := range targets {
+				if target.Velocity > 0 {
+					minKph = math.Min(minKph, target.Velocity*3.6)
+				}
+			}
+			if len(targets) == 0 || math.IsInf(minKph, 1) {
+				t.Fatal("no valid targets")
+			}
+			if tc.wantLowTarget {
+				if !hasTarget(targets, 30.884868621826172) {
+					t.Fatal("real main-road bend target changed")
+				}
+			} else if math.Round(minKph) < 55 {
+				t.Fatalf("false low main-road target at a 55 km/h setpoint: %.6f", minKph)
+			}
+			t.Logf("next=%s ref=%s minimum curve target=%.6f km/h", name, ref, minKph)
+		})
+	}
+}
